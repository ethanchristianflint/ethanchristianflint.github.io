---
layout: base.njk
---
<article>
  <header class="page-head">
    <p class="eyebrow"><span aria-hidden="true">// </span>{{ kind or "learning log" }} · <time datetime="{{ page.date | isoDate }}">{{ page.date | longDate }}</time></p>
    <h1>{{ title }}</h1>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
  <footer class="post-disclaimer">
    <p>{{ site.disclaimer }}</p>
  </footer>
</article>
